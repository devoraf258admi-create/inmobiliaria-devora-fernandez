{
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**,index.html"
    }
  },
  "redirects": [
    {
      "source": "/venta",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/venta/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ventas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ventas/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alquiler",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alquiler/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alquileres",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alquileres/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/venta-archivos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/venta-archivos/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alquiler-archivos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alquiler-archivos/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/categoria/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/categoria-producto/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/etiqueta/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archivos/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archivos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archives/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archives",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/propiedad/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/propiedades/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/propiedades",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inmueble/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inmuebles/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inmuebles",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contacto/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nosotros/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nosotros",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tasaciones/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tasaciones",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "prop"
        }
      ],
      "destination": "/api/share"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
